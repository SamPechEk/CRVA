rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function authorized() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in ['usuaria1@ejemplo.com','usuaria2@ejemplo.com']; }
  function nonnegative(v) { return v is string && v.matches('^[0-9]+([.][0-9]+)?$') && float(v) >= 0; }
  function margin(v) { return nonnegative(v) && float(v) < 1; }
  function retail() { return float(getAfter(/databases/$(database)/documents/settings/global).data.defaultMarginPct); }
  function validMaterial(d) { return d.id is string && d.name is string && d.name.size()>0 && d.category in ['Insumos directos','Empaque','Costos indirectos'] && d.unit in ['g','kg','ml','L','pza','m','kWh','min','hr','vela'] && nonnegative(d.totalPrice) && nonnegative(d.quantityPurchased) && float(d.quantityPurchased)>0 && d.isActive is bool && d.isWax is bool && d.systemRole in ['NONE','ENERGY','LABOR']; }
  function validQuote(d) { return d.id is string && d.folio is string && d.status in ['BORRADOR','ENVIADA','ACEPTADA','CANCELADA'] && margin(d.marginPct) && d.ivaPct in ['0','0.08','0.16'] && d.items is list && d.items.size()>0 && d.costBreakdownSnapshot is list && nonnegative(d.total) && nonnegative(d.subtotal) && nonnegative(d.iva) && d.createdAt is string && d.createdByEmail is string; }
  match /settings/global { allow read: if authorized(); allow create,update: if authorized() && margin(request.resource.data.defaultMarginPct) && request.resource.data.defaultIvaPct in ['0','0.08','0.16'] && nonnegative(request.resource.data.dropsPerMl) && float(request.resource.data.dropsPerMl)>0; }
  match /materials/{id} { allow read: if authorized(); allow create,update: if authorized() && request.resource.data.id==id && validMaterial(request.resource.data); }
  match /models/{id} { allow read: if authorized(); allow create,update: if authorized() && request.resource.data.id==id && request.resource.data.isActive is bool && request.resource.data.recipeItems is list && request.resource.data.batchConfig.candlesPerBatch is int && request.resource.data.batchConfig.candlesPerBatch>=1 && nonnegative(request.resource.data.batchConfig.meltPourMinutesBatch) && nonnegative(request.resource.data.batchConfig.unmoldPackMinutesBatch) && nonnegative(request.resource.data.batchConfig.energyKwhBatch) && nonnegative(request.resource.data.salesMixPct) && float(request.resource.data.salesMixPct)<=1; }
  match /pricingTiers/{id} { allow read: if authorized(); allow create,update: if authorized() && margin(request.resource.data.marginPct) && request.resource.data.minQty is int && request.resource.data.minQty>=1 && (request.resource.data.isRetailBase==true || float(request.resource.data.marginPct)<retail()); }
  match /fixedCosts/{id} { allow read: if authorized(); allow create,update: if authorized() && nonnegative(request.resource.data.monthlyAmount); }
  match /clients/{id} { allow read,delete: if authorized(); allow create,update: if authorized() && request.resource.data.id==id && request.resource.data.name is string && request.resource.data.name.size()>0; }
  match /quotes/{id} { allow read: if authorized(); allow create: if authorized() && request.resource.data.id==id && validQuote(request.resource.data); allow update: if authorized() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status in ['BORRADOR','ENVIADA','ACEPTADA','CANCELADA']; }
  match /counters/quotes { allow read: if authorized(); allow create: if authorized() && request.resource.data.year is int && request.resource.data.seq is int && request.resource.data.seq>=0; allow update: if authorized() && request.resource.data.year is int && request.resource.data.seq is int && (request.resource.data.year>resource.data.year && request.resource.data.seq>=0 || request.resource.data.year==resource.data.year && request.resource.data.seq>=resource.data.seq); }
 }
}
